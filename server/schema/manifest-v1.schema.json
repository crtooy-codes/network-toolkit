{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crtooy-codes.github.io/network-toolkit/schema/manifest-v1.schema.json",
  "title": "OpenLPS update manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "core", "app", "news", "notifications"],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "chroot64"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "chroot64": {
          "$ref": "#/$defs/asset"
        },
        "chroot32": {
          "$ref": "#/$defs/asset"
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versionCode",
        "versionName",
        "url",
        "sha256",
        "size",
        "mandatory",
        "changelog"
      ],
      "properties": {
        "versionCode": {
          "type": "integer",
          "minimum": 1
        },
        "versionName": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/crtooy-codes/network-toolkit/releases/download/"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "mandatory": {
          "type": "boolean"
        },
        "changelog": {
          "type": "string"
        }
      }
    },
    "news": {
      "type": "array"
    },
    "notifications": {
      "type": "array"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "size"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/crtooy-codes/network-toolkit/releases/download/"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
