{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crtooy-codes.github.io/network-toolkit/schema/manifest-v1.schema.json",
  "title": "OpenLPS update manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "core", "app", "news", "notifications"],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "chroot64"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "chroot64": {
          "$ref": "#/$defs/asset"
        },
        "chroot32": {
          "$ref": "#/$defs/asset"
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versionCode",
        "versionName",
        "url",
        "sha256",
        "size",
        "mandatory",
        "changelog"
      ],
      "properties": {
        "versionCode": {
          "type": "integer",
          "minimum": 1
        },
        "versionName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/crtooy-codes/network-toolkit/releases/download/"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        },
        "mandatory": {
          "type": "boolean"
        },
        "changelog": {
          "type": "string",
          "maxLength": 8000
        }
      }
    },
    "news": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/newsItem"
      }
    },
    "notifications": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/notificationItem"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "size"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/crtooy-codes/network-toolkit/releases/download/"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        }
      }
    },
    "contentUrl": {
      "type": "string",
      "pattern": "^https://(github\\.com/crtooy-codes/network-toolkit(/.*)?|crtooy-codes\\.github\\.io/network-toolkit(/.*)?)$"
    },
    "optionalContentUrl": {
      "anyOf": [
        {
          "const": ""
        },
        {
          "$ref": "#/$defs/contentUrl"
        }
      ]
    },
    "newsItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "pin": {
          "type": "boolean"
        },
        "pinned": {
          "type": "boolean"
        },
        "newsDate": {
          "type": "string",
          "maxLength": 32
        },
        "newsUrl": {
          "$ref": "#/$defs/optionalContentUrl"
        },
        "imageUrl": {
          "$ref": "#/$defs/optionalContentUrl"
        },
        "actionbutton1": {
          "type": "boolean"
        },
        "actionbutton2": {
          "type": "boolean"
        },
        "actionbutton1text": {
          "type": "string",
          "maxLength": 80
        },
        "actionbutton2text": {
          "type": "string",
          "maxLength": 80
        },
        "actionbutton1url": {
          "$ref": "#/$defs/optionalContentUrl"
        },
        "actionbutton2url": {
          "$ref": "#/$defs/optionalContentUrl"
        }
      }
    },
    "notificationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "body"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "body": {
          "type": "string",
          "maxLength": 2000
        },
        "url": {
          "$ref": "#/$defs/optionalContentUrl"
        }
      }
    }
  }
}
